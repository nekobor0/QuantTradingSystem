  "confirmed_decision_ids": ["W1_D1", "W1_D2", "W1_D3", "W1_D4", "W1_D5", "W1_D6", "W1_D7", "W1_D8", "W1_D9", "W1_D10", "W1_D11", "GFC_D1", "GFC_D2", "GFC_D3", "GFC_D4"],
  "confirmation_decisions": [
    {"id":"W1_D1","topic":"amount_units","recommended":"store official 100m_cny for GDP, money and flow series; derive trillion_cny only in feature layer"},
    {"id":"W1_D2","topic":"gdp_nominal_grain","recommended":"canonical official YTD cumulative value plus separately derived single-quarter value; never label YTD as quarter-only"},
    {"id":"W1_D3","topic":"jan_feb_industrial_period","recommended":"one observation with reference_period=YYYY-02 and period_span=YYYY-01/02; do not synthesize January"},
    {"id":"W1_D4","topic":"money_credit_revisions","recommended":"page timestamp controls availability, attachments are versioned, cumulative-to-monthly conversion is whitelist-only"},
    {"id":"W1_D5","topic":"market_rate_visibility","recommended":"DR007, R007 and ChinaBond historical values use next-trading-day visibility; forward collection may promote earlier only with observed completion time"},
    {"id":"W1_D6","topic":"policy_event_fill","recommended":"OMO, MLF and LPR remain sparse canonical event series; forward-filled levels are derived features with source event lineage"},
    {"id":"W1_D7","topic":"lpr_regime","recommended":"2019-08-20 reformed LPR is the research series; pre-reform 1Y LPR is a separate non-comparable regime and 5Y+ starts in 2019"},
    {"id":"W1_D8","topic":"historical_pit","recommended":"official current history without contemporaneous release evidence is exploratory_only; research-ready windows start where release-page vintages are reconstructed"},
    {"id":"W1_D9","topic":"chinabond_usage","recommended":"internal research only, retain terms/version evidence, query in at-most-one-year windows, no raw redistribution"},
    {"id":"W1_D10","topic":"money_credit_afre_semantic_separation","recommended":"add CN.TSF.RMB_LOANS.FLOW for the direct monthly AFRE loans-to-real-economy component; never alias it to CN.LOANS.RMB.FLOW; cumulative and balance differencing remain forbidden"},
    {"id":"W1_D11","topic":"money_credit_active_canonical_scope","recommended":"retire CN.LOANS.RMB.FLOW and CN.LOANS.CORP.MEDIUM_LONG.FLOW from the W1 active-required raw canonical set because no direct official single-month observations passed the frozen evidence policy; retain tombstones, forbid AFRE aliasing, and require any future derived flow to use a new method-versioned derived series"},
    {"id":"GFC_D1","topic":"independent_package_boundary","recommended":"global_financial_conditions is independent from China rates_liquidity and is decomposed into DomesticLiquidity, GlobalUSDConditions, and FXConstraint"},
    {"id":"GFC_D2","topic":"official_source_precedence","recommended":"use New York Fed, US Treasury, Federal Reserve H10, and CFETS official observations; adapters and aggregators are transport only and never replace raw official evidence"},
    {"id":"GFC_D3","topic":"cross_market_pit","recommended":"store reference, release, available, and tradable timestamps separately in UTC; never use a US observation in a China decision before its tradable timestamp"},
    {"id":"GFC_D4","topic":"fx_semantic_boundary","recommended":"USD.CNY is the CFETS 16:30 onshore spot close; USD.CNH requires a matched-timestamp official offshore source and may not be proxied by CNY or third-party series"}
  ]
}
