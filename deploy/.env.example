QTS_ENVIRONMENT=development
QTS_DATABASE_URL=postgresql+psycopg://example_user:invalid_example_password@localhost:5432/example_db
QTS_DATABASE_PASSWORD_FILE=./secrets/example_database_password
QTS_SESSION_SECRET_FILE=./secrets/example_session_secret
QTS_BACKUP_DIRECTORY=./local-backups
QTS_LOG_LEVEL=INFO
TRADING_MODE=paper
ALLOW_LIVE_TRADING=false
ENABLE_ORDER_SUBMISSION=false
